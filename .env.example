# Light of Science (BSS Jalpaiguri Unit) — Environment Configuration

# Database: PostgreSQL / Supabase connection string (PRD Section 4)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Without it the app runs in a local demo mode. In production demo mode is disabled: the server refuses requests instead.
DATABASE_URL="postgresql://postgres:password@localhost:5432/bss_unit_db"

# Authentication: Better Auth + Google sign-in
# In production the server REFUSES TO START without BETTER_AUTH_SECRET and BETTER_AUTH_URL. There is no built-in default.
# Secret: at least 32 random characters, different for every environment. Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public address of the site, no trailing slash. Must be https:// in production (http://localhost is fine for local tests).
BETTER_AUTH_URL="http://localhost:3000"
# Google Cloud Console > APIs & Services > Credentials > Create credentials > OAuth client ID (Web application).
# Authorised redirect URI to register:  <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMS Gateway Integration (Module B & Phase 3 Roadmap)
# Supported providers: "fast2sms" | "msg91" | "simulation"
# Leave keys empty to operate in Carrier Gateway Simulation mode.
SMS_PROVIDER="fast2sms"
FAST2SMS_API_KEY=""
FAST2SMS_SENDER_ID="BSSJPG" # DLT registered header

# Alternatively for MSG91:
MSG91_AUTH_KEY=""
MSG91_FLOW_ID=""
MSG91_SENDER_ID="BSSJPG"

# Web Push Notifications (Optional - Module D)
# Generated via web-push generate-vapid-keys
VAPID_SUBJECT="mailto:lightofscience.jalpaiguri@gmail.com"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
